# Codex CLI plus the same small GIS toolchain as Dockerfile.opencode, for the agent benchmark in evals/.
# Build:  docker build -f evals/Dockerfile.codex -t geo-software-factory-evals-codex evals
# Run:    evals/run_codex_docker.sh <workdir>     (the limits are set there, not here)
FROM python:3.12-slim-bookworm

# Pinned for reproducibility; record the version with the results.
ARG CODEX_VERSION=0.162.1
ARG TARGETARCH

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

# ripgrep: coding agents search files with rg first (Codex ran `rg --files` as its first step and failed
# without it); an image without it is harder than the environments the skills are used in.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ripgrep git \
 && rm -rf /var/lib/apt/lists/*

# codex-code-mode-host is a separate release asset that codex starts to run commands.
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) triple=x86_64-unknown-linux-musl ;; \
      arm64) triple=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac \
 && for asset in codex codex-code-mode-host; do \
      curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/${asset}-${triple}.tar.gz" \
        | tar -xz -C /usr/local/bin \
      && mv "/usr/local/bin/${asset}-${triple}" "/usr/local/bin/${asset}" \
      && chmod 0755 "/usr/local/bin/${asset}"; \
    done \
 && codex --version

RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
    'pyproj==3.7.2' 'shapely==2.1.2' 'numpy==2.3.4' 'pandas==2.3.3' pytest

ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8

RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh
RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work /home/geo/.codex && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import pyproj, shapely"
WORKDIR /work
CMD ["bash"]
