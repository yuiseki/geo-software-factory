# Antigravity CLI (agy) for Gemini models, plus the same small GIS toolchain as Dockerfile.codex, for evals/.
# Build:  docker build -f evals/Dockerfile.gemini -t geo-software-factory-evals-gemini evals
# Run:    evals/run_gemini_docker.sh <workdir>     (the limits are set there, not here)
FROM python:3.12-slim-bookworm

# Antigravity CLI (`agy`), the runner behind the Gemini eval. The official installer fetches only the latest build,
# so the build named in the manifest is downloaded directly and checked against the manifest's sha512.
# To bump it, read https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_{amd64,arm64}.json,
# copy the version, build number and both sha512 digests, and record the version with the results.
ARG AGY_VERSION=1.5.7
ARG AGY_BUILD=6190022064472064
ARG AGY_SHA512_X64=60bca280414ed11723f58b3b671962ae394cc2d0c25e3f58e32e1c6847c978cbc77ec6f40e7f3992001c399d80aeb8b64c9ec892abddd591b12413c5ee6d9fce
ARG AGY_SHA512_ARM64=bebd69ad1713414b82e370aec6be0e678a413332bf3c835d9ba22e4befff040b6c74e1bf974fd83ebc4c733ed6e37d2bdc1caae58027c2b326dd04d630bfebb1
ARG TARGETARCH

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 ca-certificates curl ripgrep git \
 && rm -rf /var/lib/apt/lists/* \
 && rg --version

RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) path=linux-x64/cli_linux_x64.tar.gz; sum=${AGY_SHA512_X64} ;; \
      arm64) path=linux-arm/cli_linux_arm64.tar.gz; sum=${AGY_SHA512_ARM64} ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/agy.tar.gz \
    "https://storage.googleapis.com/antigravity-public/antigravity-cli/${AGY_VERSION}-${AGY_BUILD}/${path}" \
 && echo "${sum}  /tmp/agy.tar.gz" | sha512sum -c - \
 && tar -xzf /tmp/agy.tar.gz -C /tmp antigravity \
 && install -m 0755 /tmp/antigravity /usr/local/bin/agy \
 && rm /tmp/agy.tar.gz /tmp/antigravity \
 && { test "$(/usr/local/bin/agy --version)" = "${AGY_VERSION}" \
      || { echo "agy is $(/usr/local/bin/agy --version), not ${AGY_VERSION}" >&2; exit 1; }; }

RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
    'pyproj==3.7.2' 'shapely==2.1.2' 'numpy==2.3.4' 'pandas==2.3.3' pytest

ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8

RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh
RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work /home/geo/.gemini && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import pyproj, shapely"
WORKDIR /work
CMD ["bash"]
