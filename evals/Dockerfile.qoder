# Qoder CLI (qodercli) plus the same small GIS toolchain as Dockerfile.codex, for the agent benchmark in evals/.
# Build:  docker build -f evals/Dockerfile.qoder -t geo-software-factory-evals-qoder evals
# Run:    evals/run_qoder_docker.sh <workdir>     (the limits are set there, not here)
FROM python:3.12-slim-bookworm

# Pinned for reproducibility; record the version with the results.
ARG QODER_VERSION=1.1.86

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 ca-certificates curl ripgrep git \
 && rm -rf /var/lib/apt/lists/* \
 && rg --version

# Qoder CLI from the official installer, pinned: it fetches a manifest per version and checks the binary's sha256.
# The binary is copied to /usr/local/bin (root-owned, so the unprivileged user cannot update it), and settings.json
# in ~/.qoder turns the auto-update off.
RUN curl -fsSL -o /tmp/qoder-install.sh https://qoder.com/install \
 && bash /tmp/qoder-install.sh --version "${QODER_VERSION}" \
 && cp -L "/root/.qoder/bin/qodercli/qodercli-${QODER_VERSION}" /usr/local/bin/qodercli \
 && chmod 0755 /usr/local/bin/qodercli \
 && rm -rf /tmp/qoder-install.sh /tmp/qodercli-* /root/.local /root/.qoder \
 && { /usr/local/bin/qodercli --version | grep -q "${QODER_VERSION}" \
      || { echo "qodercli is $(/usr/local/bin/qodercli --version), not ${QODER_VERSION}" >&2; exit 1; }; }

RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
    'pyproj==3.7.2' 'shapely==2.1.2' 'numpy==2.3.4' 'pandas==2.3.3' pytest

ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8

RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh
RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work /home/geo/.qoder \
 && printf '{"general":{"enableAutoUpdate":false}}\n' > /home/geo/.qoder/settings.json \
 && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import pyproj, shapely"
WORKDIR /work
CMD ["bash"]
